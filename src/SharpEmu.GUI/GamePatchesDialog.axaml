<local:SheetView xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:SharpEmu.GUI"
                 x:Class="SharpEmu.GUI.GamePatchesDialog"
                 SheetWidth="1040" SheetHeight="760">
  <Grid Margin="28" RowDefinitions="*,Auto,Auto" ColumnDefinitions="260,24,*">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
      <Grid Height="150">
        <TextBlock x:Name="CoverInitials" FontSize="36" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Image x:Name="GameCover" Stretch="Uniform" HorizontalAlignment="Left" />
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,14,0,18" Spacing="6">
        <TextBlock x:Name="GameNameText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock x:Name="GameInfoText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Row="2" Padding="14" CornerRadius="8" Background="{StaticResource CardBrush}">
        <Grid>
          <TextBlock x:Name="NoDetailsText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                     Text="{Binding [Library.Patches.NoDetails], Source={x:Static local:Localization.Instance}}" />
          <ScrollViewer x:Name="DetailsScroll" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="7">
              <TextBlock x:Name="DetailsName" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding [Library.Patches.AppVersion], Source={x:Static local:Localization.Instance}}" Classes="fieldLabel" Margin="0,10,0,0" />
              <SelectableTextBlock x:Name="DetailsAppVersion" TextWrapping="Wrap" />
              <TextBlock Text="{Binding [Library.Patches.PatchVersion], Source={x:Static local:Localization.Instance}}" Classes="fieldLabel" Margin="0,10,0,0" />
              <SelectableTextBlock x:Name="DetailsPatchVersion" TextWrapping="Wrap" />
              <TextBlock Text="{Binding [Library.Patches.Author], Source={x:Static local:Localization.Instance}}" Classes="fieldLabel" Margin="0,10,0,0" />
              <SelectableTextBlock x:Name="DetailsAuthor" TextWrapping="Wrap" />
              <TextBlock Text="{Binding [Library.Patches.Description], Source={x:Static local:Localization.Instance}}" Classes="fieldLabel" Margin="0,10,0,0" />
              <SelectableTextBlock x:Name="DetailsNote" TextWrapping="Wrap" />
              <TextBlock Text="{Binding [Library.Patches.Executable], Source={x:Static local:Localization.Instance}}" Classes="fieldLabel" Margin="0,10,0,0" />
              <SelectableTextBlock x:Name="DetailsExecutable" TextWrapping="Wrap" />
              <TextBlock Text="{Binding [Library.Patches.File], Source={x:Static local:Localization.Instance}}" Classes="fieldLabel" Margin="0,10,0,0" />
              <SelectableTextBlock x:Name="DetailsFile" TextWrapping="Wrap" />
              <TextBlock x:Name="DetailsStatus" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto">
      <TextBlock Text="{Binding [Library.Context.Patches], Source={x:Static local:Localization.Instance}}" FontSize="24" FontWeight="Bold" />
      <Grid Grid.Row="1" ColumnDefinitions="*,12,200" Margin="0,16,0,14">
        <TextBox x:Name="SearchBox" PlaceholderText="{Binding [Library.Patches.Search], Source={x:Static local:Localization.Instance}}" />
        <ComboBox x:Name="FileFilter" Grid.Column="2" HorizontalAlignment="Stretch"
                  ToolTip.Tip="{Binding [Library.Patches.File], Source={x:Static local:Localization.Instance}}" />
      </Grid>
      <Grid Grid.Row="2">
        <ListBox x:Name="PatchList" Background="{StaticResource CardBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{StaticResource TileSelectedBrush}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:GamePatchOption" x:CompileBindings="True">
              <Border Padding="8,10" Background="Transparent">
                <Grid ColumnDefinitions="Auto,10,*">
                  <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                            VerticalAlignment="Top" ToolTip.Tip="{Binding Patch.Name}"
                            AutomationProperties.Name="{Binding Patch.Name}" />
                  <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Text="{Binding Patch.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Patch.Author}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Text="{Binding TargetVersionText}" Foreground="{StaticResource MutedBrush}" />
                      <TextBlock Text="{Binding Patch.Executable}" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                   MaxWidth="340" Margin="16" Foreground="{StaticResource MutedBrush}" />
      </Grid>
      <TextBlock x:Name="CountText" Grid.Row="3" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
    </Grid>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="5" Margin="0,16,0,12">
      <TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
      <ScrollViewer MaxHeight="72" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
      </ScrollViewer>
    </StackPanel>
    <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
      <Button x:Name="OpenFolderButton" Classes="ghost"
              Content="{Binding [Library.Patches.OpenFolder], Source={x:Static local:Localization.Instance}}" />
      <Button x:Name="ReloadButton" Grid.Column="1" Classes="ghost" Margin="10,0,0,0"
              Content="{Binding [Library.Patches.Reload], Source={x:Static local:Localization.Instance}}" />
      <Button x:Name="DownloadButton" Grid.Column="3" Classes="ghost" Margin="0,0,10,0"
              Content="{Binding [Library.Patches.Download], Source={x:Static local:Localization.Instance}}" />
      <Button x:Name="CloseButton" Grid.Column="4" Classes="accent"
              Content="{Binding [Library.Patches.Close], Source={x:Static local:Localization.Instance}}" />
    </Grid>
  </Grid>
</local:SheetView>
