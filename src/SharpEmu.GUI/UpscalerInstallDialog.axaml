<local:SheetView xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:SharpEmu.GUI"
                 x:Class="SharpEmu.GUI.UpscalerInstallDialog"
                 SheetWidth="560">
  <StackPanel Margin="28" Spacing="12">
    <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
    <TextBlock x:Name="DestinationText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
    <ProgressBar x:Name="DownloadProgress" Maximum="100" Height="8" Margin="0,8,0,0" />
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    <Button x:Name="CloseButton" Classes="ghost" HorizontalAlignment="Right"
            Content="{Binding [Common.Cancel], Source={x:Static local:Localization.Instance}}" />
  </StackPanel>
</local:SheetView>
