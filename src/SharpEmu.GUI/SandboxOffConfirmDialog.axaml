<local:SheetView xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:SharpEmu.GUI"
                 x:Class="SharpEmu.GUI.SandboxOffConfirmDialog"
                 SheetWidth="520">
  <StackPanel Margin="28" Spacing="14">
    <TextBlock Classes="sheetTitle"
               Text="{Binding [Sandbox.OffTitle], Source={x:Static local:Localization.Instance}}"
               TextWrapping="Wrap" />

    <TextBlock Text="{Binding [Sandbox.OffMessage], Source={x:Static local:Localization.Instance}}"
               TextWrapping="Wrap" />

    <StackPanel Margin="0,8,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">
      <Button x:Name="CancelButton"
              Classes="ghost"
              Content="{Binding [Sandbox.Cancel], Source={x:Static local:Localization.Instance}}" />
      <Button x:Name="TurnOffButton"
              Content="{Binding [Sandbox.OffConfirm], Source={x:Static local:Localization.Instance}}" />
    </StackPanel>
  </StackPanel>
</local:SheetView>
