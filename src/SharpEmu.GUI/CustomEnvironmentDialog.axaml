<local:SheetView xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:SharpEmu.GUI"
                 x:Class="SharpEmu.GUI.CustomEnvironmentDialog"
                 SheetWidth="640">
  <Grid Margin="32,28" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
    <TextBlock Grid.Row="0"
               Classes="sheetTitle"
               Text="{Binding [Setting.CustomEnv.Label], Source={x:Static local:Localization.Instance}}" />

    <TextBlock Grid.Row="1"
               Margin="0,8,0,0"
               Text="{Binding [Launch.CustomEnv.Desc], Source={x:Static local:Localization.Instance}}"
               Foreground="{StaticResource SecondaryTextBrush}"
               LineHeight="20"
               TextWrapping="Wrap" />

    <Button x:Name="DocumentationButton"
            Grid.Row="2"
            Classes="link"
            Margin="0,10,0,18"
            Content="{Binding [Launch.CustomEnv.Documentation], Source={x:Static local:Localization.Instance}}" />

    <StackPanel Grid.Row="3" Spacing="10">
      <TextBox x:Name="EnvironmentTextBox"
               Classes="codeEditor"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               PlaceholderText="{Binding [Launch.CustomEnv.Placeholder], Source={x:Static local:Localization.Instance}}" />
      <TextBlock x:Name="StatusText"
                 Foreground="{StaticResource MutedBrush}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="4"
          Margin="0,18,0,0"
          ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="8">
      <Button x:Name="CancelButton"
              Grid.Column="1"
              Classes="ghost"
              Content="{Binding [Common.Cancel], Source={x:Static local:Localization.Instance}}" />
      <Button x:Name="SaveButton"
              Grid.Column="2"
              Classes="accent"
              Content="{Binding [Common.Save], Source={x:Static local:Localization.Instance}}" />
    </Grid>
  </Grid>
</local:SheetView>
