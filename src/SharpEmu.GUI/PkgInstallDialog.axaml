<local:SheetView xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:SharpEmu.GUI"
                 x:Class="SharpEmu.GUI.PkgInstallDialog"
                 SheetWidth="560">
  <StackPanel Margin="28" Spacing="12">
    <TextBlock x:Name="HeadingText"
               FontSize="20"
               FontWeight="Bold"
               TextWrapping="Wrap" />

    <TextBlock TextWrapping="Wrap"
               Text="{Binding [Library.Pkg.Explanation], Source={x:Static local:Localization.Instance}}" />

    <TextBlock x:Name="DestinationText"
               Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap" />

    <ProgressBar x:Name="InstallProgress"
                 Minimum="0"
                 Maximum="1"
                 Height="8"
                 Margin="0,8,0,0" />

    <TextBlock x:Name="StatusText"
               Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap" />

    <TextBlock x:Name="FileText"
               Foreground="{StaticResource MutedBrush}"
               TextTrimming="CharacterEllipsis" />

    <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
      <Button x:Name="CloseButton"
              Grid.Column="1"
              Classes="ghost"
              Content="{Binding [Common.Cancel], Source={x:Static local:Localization.Instance}}" />
    </Grid>
  </StackPanel>
</local:SheetView>
